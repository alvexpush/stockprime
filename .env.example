# Copy these into your hosting environment or local .env file.
FINNHUB_API_KEY=your_finnhub_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
RESEND_API_KEY=your_resend_api_key
RESET_FROM_EMAIL=StockPrime <support@example.com>
AUTH_FROM_EMAIL=StockPrime <security@example.com>

# Zoho Mail REST API over HTTPS (recommended for Railway)
# Required OAuth scopes: ZohoMail.messages.CREATE,ZohoMail.accounts.READ
# Full guide: ZOHO_RAILWAY_EMAIL_SETUP.md
EMAIL_PROVIDER=zoho
APP_URL=https://your-production-domain.example
OTP_SECRET=generate_a_long_random_secret_for_hmac
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
# One-time Self Client code; cleared automatically by npm run email:authorize
ZOHO_GRANT_CODE=
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
# Optional: discovered automatically using ZohoMail.accounts.READ when omitted
ZOHO_ACCOUNT_ID=your_numeric_zoho_mail_account_id
ZOHO_FROM_EMAIL=spgonline@zohomail.com
# Optional recipient used only by: npm run email:check -- --send
EMAIL_TEST_TO=
# Change both hosts for your Zoho data center, e.g. .eu, .in, .com.au, .jp, .ca, .ae, .sa
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com/api
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
SESSION_DAYS=7
PORT=3000
